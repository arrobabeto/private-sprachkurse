ORBITYPE_MOCK=true

# Optional for live Orbitype CMS mode:
# ORBITYPE_API_SQL_URL="https://core.orbitype.com/api/sql/v1"
# ORBITYPE_API_SQL_KEY="your-api-key"
# ORBITYPE_API_S3_URL="https://core.orbitype.com/api/s3/v1"
# ORBITYPE_API_S3_KEY="your-s3-api-key"

# Cursor MCP env vars (export in ~/.zshrc — see docs/orbitype-cms-mcp.md):
# ORBITYPE_SQL_API_KEY_PRIVATE_SPRACHKURSE="your-sql-api-key"
# ORBITYPE_S3_API_KEY_PRIVATE_SPRACHKURSE="your-s3-api-key"

# Figma MCP (personal access token — see docs/figma-mcp.md):
# FIGMA_API_KEY="your-figma-personal-access-token"
# FIGMA_FILE_KEY="your-figma-file-key"

# SendGrid (contact forms → email)
# FROM must be a verified Sender Identity in SendGrid.
# Until info@privatesprachkurse.ch is verified, use a verified Bexolutions sender.
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="it@bexolutions.ch"
SENDGRID_FROM_NAME="Private Sprachkurse"
SENDGRID_TO_EMAIL="info@privatesprachkurse.ch"

# Public SEO / branding settings:
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_SITE_NAME="Private Sprachkurse"
NUXT_PUBLIC_SITE_DESCRIPTION="Persönlicher Sprachunterricht für Alltag und Beruf – individuell, flexibel und mit Freude am Lernen."
NUXT_PUBLIC_ORGANIZATION_NAME="Private Sprachkurse"
NUXT_PUBLIC_ORGANIZATION_LOGO="/favicon.png"
NUXT_PUBLIC_SITE_LOCALE="de_DE"
NUXT_PUBLIC_TWITTER_SITE="@orbitype"
NUXT_PUBLIC_TWITTER_CREATOR="@orbitype"
NUXT_PUBLIC_OG_IMAGE_ENABLED="true"
NUXT_PUBLIC_COMMENTS_ENABLED="false"
NUXT_PUBLIC_OG_LOGO_PATH="/favicon.png"
# Optional GTM container (empty disables GTM script injection):
NUXT_PUBLIC_GTM_ID=""
